# Example only. Never commit your real .env or secrets.
# Load these variables with your process manager / shell; Node does not auto-load this file.
PUBLIC_ORIGIN=https://rental.example.com
DATABASE_PATH=/var/lib/voltgo/production.sqlite
HOST=127.0.0.1
PORT=4173
# Leave Google blank until you configure a Web OAuth client and an HTTPS domain.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Never enable local HTTP on a public address.
ALLOW_LOCAL_HTTP=0
# No PVS/WsCharge credentials are accepted yet: providers remain disabled.

# Temporary customer test login; disabled if either Google credential is set.
# Enable deliberately on your test deployment only, then restart the app.
ENABLE_GOOGLE_TEST_LOGIN=0

# Physical QR testing: mock payments, real device; all signed-in accounts can test when enabled.
WSCHARGE_HARDWARE_TEST_ENABLED=0
